<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="550"
        x:Class="notatnik.MainWindow"
        Title="Notatnik" Width="700" Height="500">
    <Grid ColumnDefinitions="*, 250" Margin="15">
        <StackPanel Grid.Column="0" Spacing="10" Margin="0,0,15,0">
            <TextBlock Text="Tytuł notatki:" FontWeight="Bold" />
            <TextBox Name="TitleBox" PlaceholderText="Wpisz tytuł..." />
            
            <TextBlock Text="Treść notatki:" FontWeight="Bold" />
            <TextBox Name="ContentBox" AcceptsReturn="True" Height="220" TextWrapping="Wrap" PlaceholderText="Wpisz treść..." />
            
            <Button Name="SaveButton" Content="Zapisz" Click="OnSaveClicked" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            <TextBlock Name="StatusText" Margin="0,5,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <DockPanel Grid.Column="1">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10" Spacing="8">
                <ToggleSwitch Name="ThemeToggle"
                              OnContent="Ciemny"
                              OffContent="Jasny"
                              IsCheckedChanged="OnThemeToggleChanged"
                              HorizontalAlignment="Right" />
                <TextBlock Text="Zapisane notatki:" FontWeight="Bold" />
            </StackPanel>
            <ListBox Name="NotesList" />
        </DockPanel>
    </Grid>
</Window>
